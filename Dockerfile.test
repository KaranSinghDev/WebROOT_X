# We use Ubuntu for the test runner because it builds faster
FROM ubuntu:22.04

# Install dependencies (apt is faster than dnf)
RUN apt-get update && \
    apt-get install -y g++ cmake make git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /verify
COPY . .

# Build and Run Tests
RUN mkdir build && cd build && \
    cmake ../engine && \
    cmake --build . && \
    ./unit_tests
